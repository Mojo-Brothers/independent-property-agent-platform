---
import { BRAND } from '../lib/constants';
import '../styles/global.css';

interface Props {
  title?: string;
  activeNav?: string;
}

const { title = `Admin Portal – ${BRAND.name}`, activeNav = 'overview' } = Astro.props;

const currentPath = Astro.url.pathname;

const adminNavItems = [
  { id: 'overview', label: 'Ringkasan Dashboard', href: '/admin' },
  { id: 'properties', label: 'Kelola Properti', href: '/admin/properties' },
  { id: 'developers', label: 'Kelola Developer', href: '/admin/developers' },
  { id: 'projects', label: 'Proyek Kawasan', href: '/admin/projects' },
  { id: 'units', label: 'Inventori Stok Unit', href: '/admin/units' },
  { id: 'leads', label: 'Lead & Inquiry CRM', href: '/admin/leads' },
  { id: 'partnerships', label: 'Pengajuan Kemitraan', href: '/admin/partnerships' },
  { id: 'settings', label: 'Pengaturan & SEO', href: '/admin/settings' },
];
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | {BRAND.name}</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="bg-slate-100 text-slate-900 antialiased min-h-screen flex flex-col lg:flex-row">
    
    <!-- Sidebar (Desktop & Mobile) -->
    <aside class="w-full lg:w-64 bg-navy-950 text-slate-300 flex-shrink-0 flex flex-col justify-between border-r border-navy-800">
      <div>
        <!-- Sidebar Brand Header -->
        <div class="h-20 flex items-center px-6 border-b border-navy-800 space-x-3">
          <div class="w-9 h-9 rounded-lg bg-navy-900 border border-gold-400/40 flex items-center justify-center text-gold-400 font-bold text-xs tracking-wider">
            I&amp;G
          </div>
          <div class="overflow-hidden">
            <span class="block text-xs font-bold text-white tracking-wide truncate">{BRAND.name}</span>
            <span class="block text-[10px] text-gold-400 font-medium uppercase tracking-wider">Advisory Portal</span>
          </div>
        </div>

        <!-- Sidebar Navigation -->
        <nav class="p-4 space-y-1">
          {adminNavItems.map((item) => {
            const isActive = activeNav === item.id;
            return (
              <a
                href={item.href}
                class={`flex items-center px-3.5 py-2.5 rounded-lg text-xs font-medium transition-colors ${
                  isActive
                    ? 'bg-navy-900 text-gold-400 border border-gold-400/30 font-semibold'
                    : 'text-slate-300 hover:bg-navy-900/60 hover:text-white'
                }`}
              >
                <span class="w-2 h-2 rounded-full mr-2.5 bg-gold-400/60"></span>
                <span>{item.label}</span>
              </a>
            );
          })}
        </nav>
      </div>

      <!-- Sidebar Footer User Profile -->
      <div class="p-4 border-t border-navy-800">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-2">
            <div class="w-8 h-8 rounded-full bg-gold-400/20 text-gold-400 flex items-center justify-center font-bold text-xs">
              IG
            </div>
            <div class="text-xs">
              <span class="block font-bold text-white leading-tight">Ivory & Grace</span>
              <span class="block text-[10px] text-slate-400">Advisory Team</span>
            </div>
          </div>
          <button
            type="button"
            id="admin-logout-btn"
            class="text-[11px] text-rose-400 hover:text-rose-300 font-semibold px-2 py-1 rounded hover:bg-navy-900 transition-colors"
            title="Keluar dari sesi admin"
          >
            Keluar
          </button>
        </div>
      </div>
    </aside>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col min-w-0">
      
      <!-- Topbar Header -->
      <header class="h-16 bg-white border-b border-slate-200 px-6 sm:px-8 flex items-center justify-between">
        <div>
          <h1 class="text-base sm:text-lg font-bold text-navy-950">{title}</h1>
        </div>
        <div class="flex items-center space-x-4">
          <a
            href="/"
            target="_blank"
            class="inline-flex items-center text-xs font-semibold text-slate-600 hover:text-navy-950 bg-slate-100 hover:bg-slate-200 px-3 py-1.5 rounded-md transition-colors"
          >
            <svg class="w-3.5 h-3.5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
            Buka Website Publik
          </a>
        </div>
      </header>

      <!-- Main Slot Content -->
      <main class="flex-1 p-6 sm:p-8 bg-slate-50 overflow-y-auto">
        <slot />
      </main>

    </div>

  </body>
</html>

<script>
  const logoutBtn = document.getElementById('admin-logout-btn');
  if (logoutBtn) {
    logoutBtn.addEventListener('click', async () => {
      try {
        await fetch('/api/auth/logout', { method: 'POST' });
        window.location.href = '/admin/login';
      } catch (err) {
        window.location.href = '/admin/login';
      }
    });
  }
</script>
