---
---

<div class="bg-white rounded-2xl p-6 sm:p-10 shadow-lg border border-slate-200">
  <div class="mb-6">
    <span class="inline-block px-3 py-1 rounded bg-gold-400/10 text-gold-700 text-xs font-semibold uppercase tracking-wider mb-2">
      Formulir Pengajuan Kemitraan Pemasaran
    </span>
    <h3 class="text-2xl font-bold text-navy-950">
      Mulai Sinergi Pemasaran Proyek Anda
    </h3>
    <p class="text-sm text-slate-600 mt-2">
      Ajukan proposal atau undangan presentasi kemitraan untuk proyek cluster, perumahan baru, atau unit komersial Anda di koridor Bekasi dan Cikarang.
    </p>
  </div>

  <form id="partnership-form" class="space-y-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="company_name" class="block text-xs font-semibold text-slate-700 mb-1">
          Nama Perusahaan / Pengembang <span class="text-rose-500">*</span>
        </label>
        <input
          type="text"
          id="company_name"
          name="company_name"
          required
          placeholder="Contoh: PT Bangun Persada Indah"
          class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-gold-400 focus:border-gold-400 outline-none transition-all"
        />
      </div>

      <div>
        <label for="project_name" class="block text-xs font-semibold text-slate-700 mb-1">
          Nama Proyek / Cluster <span class="text-rose-500">*</span>
        </label>
        <input
          type="text"
          id="project_name"
          name="project_name"
          required
          placeholder="Contoh: Asteria Garden Residence"
          class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-gold-400 focus:border-gold-400 outline-none transition-all"
        />
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div>
        <label for="pic_name" class="block text-xs font-semibold text-slate-700 mb-1">
          Nama PIC / Pejabat Berwenang <span class="text-rose-500">*</span>
        </label>
        <input
          type="text"
          id="pic_name"
          name="pic_name"
          required
          placeholder="Nama Anda"
          class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-gold-400 focus:border-gold-400 outline-none transition-all"
        />
      </div>

      <div>
        <label for="phone" class="block text-xs font-semibold text-slate-700 mb-1">
          Nomor Telepon / WhatsApp <span class="text-rose-500">*</span>
        </label>
        <input
          type="tel"
          id="phone"
          name="phone"
          required
          placeholder="0812xxxxxxxx"
          class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-gold-400 focus:border-gold-400 outline-none transition-all"
        />
      </div>

      <div>
        <label for="email" class="block text-xs font-semibold text-slate-700 mb-1">
          Alamat Email Resmi <span class="text-rose-500">*</span>
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          placeholder="pic@perusahaan.co.id"
          class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-gold-400 focus:border-gold-400 outline-none transition-all"
        />
      </div>
    </div>

    <div>
      <label for="proposal_message" class="block text-xs font-semibold text-slate-700 mb-1">
        Ringkasan Proyek & Harapan Model Pemasaran <span class="text-rose-500">*</span>
      </label>
      <textarea
        id="proposal_message"
        name="proposal_message"
        rows="4"
        required
        placeholder="Sebutkan lokasi proyek, jumlah unit tersedia/stok, kisaran harga, dan bentuk kemitraan yang diharapkan (Exclusive Agent, Co-Brokering, atau Open Listing)..."
        class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-gold-400 focus:border-gold-400 outline-none transition-all"
      ></textarea>
    </div>

    <div id="partnership-feedback" class="hidden text-xs p-3 rounded-lg"></div>

    <div class="pt-2">
      <button
        type="submit"
        id="submit-partnership-btn"
        class="w-full py-3.5 px-6 bg-navy-950 hover:bg-navy-900 text-gold-300 font-semibold text-sm rounded-lg shadow-md hover:shadow-lg transition-all flex items-center justify-center space-x-2"
      >
        <span>Ajukan Kemitraan Strategis</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </button>
    </div>
  </form>
</div>

<script>
  const form = document.getElementById('partnership-form') as HTMLFormElement;
  const feedback = document.getElementById('partnership-feedback');
  const btn = document.getElementById('submit-partnership-btn');

  if (form && feedback && btn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      btn.setAttribute('disabled', 'true');
      btn.classList.add('opacity-70');
      feedback.classList.remove('hidden', 'bg-rose-50', 'text-rose-700', 'bg-emerald-50', 'text-emerald-700');
      feedback.classList.add('bg-slate-100', 'text-slate-700');
      feedback.textContent = 'Mengirimkan pengajuan kemitraan...';

      const formData = new FormData(form);
      const payload = {
        company_name: formData.get('company_name'),
        project_name: formData.get('project_name'),
        pic_name: formData.get('pic_name'),
        phone: formData.get('phone'),
        email: formData.get('email'),
        proposal_message: formData.get('proposal_message'),
      };

      try {
        const res = await fetch('/api/partnerships', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const data = await res.json();
        if (res.ok && data.success) {
          feedback.classList.remove('bg-slate-100', 'text-slate-700');
          feedback.classList.add('bg-emerald-50', 'text-emerald-700', 'border', 'border-emerald-200');
          feedback.textContent = data.message;
          form.reset();
        } else {
          feedback.classList.remove('bg-slate-100', 'text-slate-700');
          feedback.classList.add('bg-rose-50', 'text-rose-700', 'border', 'border-rose-200');
          feedback.textContent = data.message || 'Gagal mengirimkan pengajuan. Mohon periksa kembali formulir.';
        }
      } catch (err) {
        feedback.classList.remove('bg-slate-100', 'text-slate-700');
        feedback.classList.add('bg-rose-50', 'text-rose-700', 'border', 'border-rose-200');
        feedback.textContent = 'Gagal terhubung ke server. Silakan hubungi langsung via email resmi.';
      } finally {
        btn.removeAttribute('disabled');
        btn.classList.remove('opacity-70');
      }
    });
  }
</script>
