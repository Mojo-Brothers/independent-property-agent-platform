---
import { BRAND, PROPERTY_LOCATIONS, PROPERTY_TYPES } from '../lib/constants';
---

<section class="relative bg-navy-950 text-white overflow-hidden py-16 lg:py-24 border-b border-navy-800">
  <!-- Subtle Architectural Background Grid & Ambient Lighting -->
  <div class="absolute inset-0 opacity-15 pointer-events-none bg-[radial-gradient(#C5A880_1px,transparent_1px)] [background-size:24px_24px]"></div>
  <div class="absolute -top-40 -right-40 w-96 h-96 bg-gold-400/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-navy-700/30 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Column: Corporate Positioning & Value Proposition -->
      <div class="lg:col-span-7 space-y-6">
        
        <div class="inline-flex items-center space-x-2 px-3 py-1.5 rounded-full bg-navy-900 border border-gold-400/30 text-xs font-semibold text-gold-300">
          <span class="w-2 h-2 rounded-full bg-gold-400 animate-pulse"></span>
          <span class="tracking-wider uppercase">{BRAND.parentBrand} &bull; {BRAND.category}</span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-extrabold tracking-tight text-white leading-tight">
          Connecting <span class="text-gold-gradient italic">Properties</span> with Opportunities.
        </h1>

        <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl font-light">
          <strong>{BRAND.name}</strong> merupakan lini bisnis pemasaran dan konsultasi properti yang menghubungkan pengembang, pemilik properti, investor, dan calon pembeli melalui layanan pemasaran yang profesional, terukur, dan transparan.
        </p>

        <!-- Bullet Highlights -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs text-slate-300 pt-2">
          <div class="flex items-center space-x-2">
            <svg class="w-4 h-4 text-gold-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Verifikasi legalitas & ketersediaan stok fisik</span>
          </div>
          <div class="flex items-center space-x-2">
            <svg class="w-4 h-4 text-gold-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Sinergi pemasaran pengembang & pemilik aset</span>
          </div>
          <div class="flex items-center space-x-2">
            <svg class="w-4 h-4 text-gold-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Bebas biaya perantara bagi pembeli unit</span>
          </div>
          <div class="flex items-center space-x-2">
            <svg class="w-4 h-4 text-gold-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Pendampingan KPR, appraisal & notaris tuntas</span>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-wrap gap-4 pt-4">
          <a
            href="/properties"
            class="px-6 py-3.5 rounded-lg bg-gold-400 hover:bg-gold-300 text-navy-950 font-bold text-xs uppercase tracking-wider shadow-gold-glow transition-all duration-200 flex items-center space-x-2"
          >
            <span>Jelajahi Portofolio Properti</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a
            href="/developer-partnership"
            class="px-6 py-3.5 rounded-lg bg-navy-900 hover:bg-navy-850 text-white font-semibold text-xs uppercase tracking-wider border border-gold-400/40 hover:border-gold-400 transition-all duration-200"
          >
            Kemitraan Pengembang & Pemilik
          </a>
        </div>

      </div>

      <!-- Right Column: Visual Showcase & Property Quick Search -->
      <div class="lg:col-span-5">
        <div class="bg-navy-900/90 border border-gold-400/30 rounded-2xl p-6 sm:p-8 backdrop-blur-md shadow-2xl space-y-6">
          
          <div class="border-b border-navy-800 pb-4">
            <span class="text-xs font-semibold text-gold-400 uppercase tracking-widest block">Property Finder</span>
            <h2 class="text-xl font-bold font-serif text-white mt-1">Cari Properti di Koridor Strategis</h2>
            <p class="text-xs text-slate-400 mt-1">Temukan unit hunian baru, cluster siap huni, atau aset komersial.</p>
          </div>

          <form action="/properties" method="GET" class="space-y-4">
            
            <div>
              <label for="filter-location" class="block text-xs font-medium text-slate-300 mb-1.5">
                Area Wilayah
              </label>
              <select
                id="filter-location"
                name="location"
                class="w-full bg-navy-950 border border-navy-700 rounded-lg px-3.5 py-2.5 text-xs text-white focus:outline-none focus:border-gold-400"
              >
                {PROPERTY_LOCATIONS.map((loc) => (
                  <option value={loc === 'Semua Lokasi' ? '' : loc}>{loc}</option>
                ))}
              </select>
            </div>

            <div>
              <label for="filter-type" class="block text-xs font-medium text-slate-300 mb-1.5">
                Kategori Properti
              </label>
              <select
                id="filter-type"
                name="type"
                class="w-full bg-navy-950 border border-navy-700 rounded-lg px-3.5 py-2.5 text-xs text-white focus:outline-none focus:border-gold-400"
              >
                {PROPERTY_TYPES.map((type) => (
                  <option value={type === 'Semua Tipe' ? '' : type}>{type}</option>
                ))}
              </select>
            </div>

            <div>
              <label for="filter-price" class="block text-xs font-medium text-slate-300 mb-1.5">
                Kisaran Budget
              </label>
              <select
                id="filter-price"
                name="price"
                class="w-full bg-navy-950 border border-navy-700 rounded-lg px-3.5 py-2.5 text-xs text-white focus:outline-none focus:border-gold-400"
              >
                <option value="">Semua Kisaran Budget</option>
                <option value="500jt">&lt; Rp 500 Juta</option>
                <option value="500jt-1m">Rp 500 Juta - Rp 1 Miliar</option>
                <option value="1m-2m">Rp 1 Miliar - Rp 2 Miliar</option>
                <option value="2m">&gt; Rp 2 Miliar</option>
              </select>
            </div>

            <div class="pt-2">
              <button
                type="submit"
                class="w-full py-3 px-4 rounded-lg bg-gold-400 hover:bg-gold-300 text-navy-950 font-bold text-xs tracking-wider uppercase transition-colors shadow-sm flex items-center justify-center space-x-2"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                <span>Tampilkan Properti Tersedia</span>
              </button>
            </div>

          </form>

          <div class="pt-2 border-t border-navy-800 text-[11px] text-slate-400 text-center">
            Konsultasi portofolio khusus? <a href="/contact" class="text-gold-400 hover:underline">Hubungi Tim Kami</a>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>
