---
import type { Property } from '../lib/types';
import { BRAND } from '../lib/constants';

interface Props {
  property: Property;
}

const { property } = Astro.props;
const coverImage = property.images.find((img) => img.is_cover) || property.images[0];
---

<article class="group bg-white rounded-xl overflow-hidden border border-slate-200/80 hover:border-gold-400/60 shadow-sm hover:shadow-card-elevated transition-all duration-300 flex flex-col h-full">
  
  <!-- Image & Status Badges -->
  <div class="relative aspect-[16/10] w-full overflow-hidden bg-navy-950">
    <img
      src={coverImage?.image_url || 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=800&q=80'}
      alt={coverImage?.alt_text || property.title}
      loading="lazy"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-navy-950/80 via-transparent to-black/20 pointer-events-none"></div>

    <!-- Top Left Badges -->
    <div class="absolute top-3 left-3 flex flex-wrap gap-1.5 z-10">
      {property.is_demo && (
        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold bg-amber-500/90 text-navy-950 tracking-wider">
          DEMO
        </span>
      )}
      <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-navy-900/90 text-gold-300 border border-gold-400/30 backdrop-blur-sm">
        {property.property_type}
      </span>
    </div>

    <!-- Top Right Listing Type -->
    <div class="absolute top-3 right-3 z-10">
      <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-white/95 text-navy-950 shadow-sm">
        {property.listing_type}
      </span>
    </div>

    <!-- Bottom Image Overlay: Price -->
    <div class="absolute bottom-3 left-3 right-3 z-10 flex items-end justify-between">
      <div>
        <p class="text-[11px] uppercase tracking-wider text-slate-300 font-medium">Mulai Dari</p>
        <p class="text-xl font-bold text-white tracking-tight text-gold-300">
          {property.price_display}
        </p>
      </div>
      <div class="text-[10px] text-slate-300 bg-navy-900/80 px-2 py-1 rounded backdrop-blur-sm border border-slate-700">
        Sertifikat: <span class="font-semibold text-white">{property.certificate_type}</span>
      </div>
    </div>
  </div>

  <!-- Content & Details -->
  <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
    
    <div>
      <!-- Location Subtitle -->
      <div class="flex items-center text-xs text-slate-500 mb-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 mr-1 text-gold-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span>{property.location_district}, {property.location_city}</span>
      </div>

      <!-- Property Title -->
      <h3 class="text-base font-bold text-navy-950 group-hover:text-gold-600 transition-colors line-clamp-2">
        <a href={`/properties/${property.slug}`}>
          {property.title}
        </a>
      </h3>

      <p class="text-xs text-slate-600 mt-2 line-clamp-2 leading-relaxed">
        {property.description}
      </p>
    </div>

    <!-- Specifications Grid -->
    <div class="pt-3 border-t border-slate-100 grid grid-cols-4 gap-2 text-center text-xs text-slate-600 bg-slate-50/70 p-2 rounded-lg">
      <div>
        <span class="block text-[10px] text-slate-400 font-medium uppercase">K. Tidur</span>
        <span class="font-bold text-navy-900">{property.bedrooms}</span>
      </div>
      <div>
        <span class="block text-[10px] text-slate-400 font-medium uppercase">K. Mandi</span>
        <span class="font-bold text-navy-900">{property.bathrooms}</span>
      </div>
      <div>
        <span class="block text-[10px] text-slate-400 font-medium uppercase">L. Bangunan</span>
        <span class="font-bold text-navy-900">{property.building_area_sqm} m²</span>
      </div>
      <div>
        <span class="block text-[10px] text-slate-400 font-medium uppercase">L. Tanah</span>
        <span class="font-bold text-navy-900">{property.land_area_sqm} m²</span>
      </div>
    </div>

    <!-- Last Verification & Action CTAs -->
    <div class="space-y-3 pt-2">
      <div class="flex items-center justify-between text-[11px] text-slate-400">
        <span class="flex items-center">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5 animate-pulse"></span>
          Verifikasi Stok: {property.last_inventory_verified_at}
        </span>
        <span class="text-slate-400">Konfirmasi Unit</span>
      </div>

      <div class="grid grid-cols-2 gap-2">
        <a
          href={`/properties/${property.slug}`}
          class="w-full inline-flex items-center justify-center px-3 py-2 text-xs font-semibold rounded-md text-navy-950 bg-slate-100 hover:bg-slate-200 transition-colors border border-slate-200"
        >
          Detail Lengkap
        </a>
        <a
          href={`https://wa.me/${BRAND.whatsapp}?text=Halo%20Tim%20Ivory%20%26%20Grace%20Property,%20saya%20tertarik%20dengan%20properti:%20${encodeURIComponent(property.title)}%20(${encodeURIComponent(property.price_display)})`}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full inline-flex items-center justify-center px-3 py-2 text-xs font-semibold rounded-md text-navy-950 bg-gold-400 hover:bg-gold-300 transition-colors shadow-sm"
        >
          Tanya Unit
        </a>
      </div>
    </div>

  </div>

</article>
