---
interface Props {
  propertyId?: string;
  propertyTitle?: string;
}

const { propertyId = '', propertyTitle = '' } = Astro.props;
---

<div
  id="inquiry-modal"
  class="fixed inset-0 z-50 hidden bg-navy-950/80 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
>
  <div class="bg-white rounded-2xl max-w-lg w-full p-6 sm:p-8 shadow-2xl border border-slate-200 relative my-8">
    
    <!-- Close Button -->
    <button
      id="close-inquiry-modal"
      type="button"
      class="absolute top-4 right-4 text-slate-400 hover:text-navy-950 p-2 rounded-full hover:bg-slate-100 transition-colors"
      aria-label="Tutup Formulir"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <div class="mb-6">
      <span class="inline-block px-2.5 py-1 rounded bg-gold-400/10 text-gold-700 text-xs font-semibold mb-2">
        Konsultasi & Ketersediaan Unit
      </span>
      <h3 id="modal-title" class="text-xl font-bold text-navy-950">
        Formulir Informasi Properti
      </h3>
      <p class="text-xs text-slate-500 mt-1" id="modal-property-subtitle">
        {propertyTitle ? `Unit: ${propertyTitle}` : 'Dapatkan informasi ketersediaan unit, simulasi KPR, dan jadwal survey lokasi langsung bersama Tim Konsultan Ivory & Grace Property.'}
      </p>
    </div>

    <form id="inquiry-form" class="space-y-4">
      <input type="hidden" name="property_id" id="inquiry-property-id" value={propertyId} />

      <div>
        <label for="full_name" class="block text-xs font-semibold text-slate-700 mb-1">
          Nama Lengkap <span class="text-rose-500">*</span>
        </label>
        <input
          type="text"
          id="full_name"
          name="full_name"
          required
          placeholder="Contoh: Bpk. Hendra Gunawan"
          class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-gold-400 focus:border-gold-400 outline-none transition-all"
        />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="phone_whatsapp" class="block text-xs font-semibold text-slate-700 mb-1">
            Nomor WhatsApp <span class="text-rose-500">*</span>
          </label>
          <input
            type="tel"
            id="phone_whatsapp"
            name="phone_whatsapp"
            required
            placeholder="0812xxxxxxxx"
            class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-gold-400 focus:border-gold-400 outline-none transition-all"
          />
        </div>
        <div>
          <label for="email" class="block text-xs font-semibold text-slate-700 mb-1">
            Email (Opsional)
          </label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="nama@email.com"
            class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-gold-400 focus:border-gold-400 outline-none transition-all"
          />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="budget_range" class="block text-xs font-semibold text-slate-700 mb-1">
            Alokasi Budget <span class="text-rose-500">*</span>
          </label>
          <select
            id="budget_range"
            name="budget_range"
            required
            class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-gold-400 focus:border-gold-400 outline-none transition-all bg-white"
          >
            <option value="">Pilih Rentang Budget</option>
            <option value="Di bawah Rp 500 Juta">&lt; Rp 500 Juta</option>
            <option value="Rp 500 Juta - Rp 1 Miliar">Rp 500 Juta - Rp 1 Miliar</option>
            <option value="Rp 1 Miliar - Rp 2 Miliar">Rp 1 Miliar - Rp 2 Miliar</option>
            <option value="Di atas Rp 2 Miliar">&gt; Rp 2 Miliar</option>
          </select>
        </div>

        <div>
          <label for="purchase_purpose" class="block text-xs font-semibold text-slate-700 mb-1">
            Tujuan Pembelian <span class="text-rose-500">*</span>
          </label>
          <select
            id="purchase_purpose"
            name="purchase_purpose"
            required
            class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-gold-400 focus:border-gold-400 outline-none transition-all bg-white"
          >
            <option value="Tempat Tinggal Pribadi">Tempat Tinggal Pribadi</option>
            <option value="Investasi Sewa">Investasi / Disewakan</option>
            <option value="Pilihan Pertama Anak">Rumah Pertama Anak</option>
            <option value="Lainnya">Lainnya</option>
          </select>
        </div>
      </div>

      <div>
        <label for="message" class="block text-xs font-semibold text-slate-700 mb-1">
          Catatan / Pertanyaan Tambahan
        </label>
        <textarea
          id="message"
          name="message"
          rows="3"
          placeholder="Tanyakan jadwal survey unit, estimasi DP, promo developer, dll."
          class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-gold-400 focus:border-gold-400 outline-none transition-all"
        ></textarea>
      </div>

      <div class="flex items-start space-x-2 pt-1">
        <input
          type="checkbox"
          id="consent_agreed"
          name="consent_agreed"
          required
          checked
          class="mt-1 h-4 w-4 text-gold-500 focus:ring-gold-400 border-slate-300 rounded"
        />
        <label for="consent_agreed" class="text-[11px] text-slate-500 leading-normal">
          Saya menyetujui pemrosesan data di atas oleh Tim Ivory & Grace Property untuk keperluan konsultasi dan penawaran properti terkait sesuai <a href="/privacy-policy" class="text-gold-600 underline" target="_blank">Kebijakan Privasi</a>.
        </label>
      </div>

      <div id="form-feedback" class="hidden text-xs p-3 rounded-lg"></div>

      <div class="pt-2">
        <button
          type="submit"
          id="submit-inquiry-btn"
          class="w-full py-3 px-4 bg-navy-950 hover:bg-navy-900 text-gold-300 font-semibold text-sm rounded-lg shadow-md hover:shadow-lg transition-all flex items-center justify-center space-x-2"
        >
          <span>Kirim Permintaan Informasi</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </button>
      </div>

    </form>

  </div>
</div>

<script>
  declare global {
    interface Window {
      openInquiryModal?: (propertyId?: string, propertyTitle?: string) => void;
    }
  }

  const modal = document.getElementById('inquiry-modal');
  const closeBtn = document.getElementById('close-inquiry-modal');
  const form = document.getElementById('inquiry-form') as HTMLFormElement;
  const feedback = document.getElementById('form-feedback');
  const submitBtn = document.getElementById('submit-inquiry-btn');

  // Global open function
  window.openInquiryModal = function (propertyId = '', propertyTitle = '') {
    if (modal) {
      const inputId = document.getElementById('inquiry-property-id') as HTMLInputElement;
      const subtitle = document.getElementById('modal-property-subtitle');
      if (inputId) inputId.value = propertyId;
      if (subtitle && propertyTitle) {
        subtitle.textContent = `Unit: ${propertyTitle}`;
      }
      modal.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
    }
  };

  function closeModal() {
    if (modal) {
      modal.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
      if (feedback) feedback.classList.add('hidden');
    }
  }

  if (closeBtn) closeBtn.addEventListener('click', closeModal);
  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
  }

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!feedback || !submitBtn) return;

      submitBtn.setAttribute('disabled', 'true');
      submitBtn.classList.add('opacity-70');
      feedback.classList.remove('hidden', 'bg-rose-50', 'text-rose-700', 'bg-emerald-50', 'text-emerald-700');
      feedback.classList.add('bg-slate-100', 'text-slate-700');
      feedback.textContent = 'Memproses data...';

      const formData = new FormData(form);
      const payload = {
        full_name: formData.get('full_name'),
        phone_whatsapp: formData.get('phone_whatsapp'),
        email: formData.get('email') || undefined,
        property_id: formData.get('property_id') || undefined,
        budget_range: formData.get('budget_range'),
        purchase_purpose: formData.get('purchase_purpose'),
        message: formData.get('message') || undefined,
        consent_agreed: formData.get('consent_agreed') === 'on',
      };

      try {
        const response = await fetch('/api/inquiries', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const result = await response.json();

        if (response.ok && result.success) {
          feedback.classList.remove('bg-slate-100', 'text-slate-700');
          feedback.classList.add('bg-emerald-50', 'text-emerald-700', 'border', 'border-emerald-200');
          feedback.textContent = result.message;
          form.reset();
          setTimeout(() => {
            closeModal();
          }, 3500);
        } else {
          feedback.classList.remove('bg-slate-100', 'text-slate-700');
          feedback.classList.add('bg-rose-50', 'text-rose-700', 'border', 'border-rose-200');
          feedback.textContent = result.message || 'Gagal mengirim data. Periksa kembali isian formulir.';
        }
      } catch (err) {
        feedback.classList.remove('bg-slate-100', 'text-slate-700');
        feedback.classList.add('bg-rose-50', 'text-rose-700', 'border', 'border-rose-200');
        feedback.textContent = 'Terjadi gangguan jaringan. Silakan hubungi via WhatsApp langsung.';
      } finally {
        submitBtn.removeAttribute('disabled');
        submitBtn.classList.remove('opacity-70');
      }
    });
  }
</script>

<script is:inline>
  // Expose to window for inline onclick handlers
  window.openInquiryModal = window.openInquiryModal || function(id, title) {
    const m = document.getElementById('inquiry-modal');
    if (m) {
      const pid = document.getElementById('inquiry-property-id');
      const st = document.getElementById('modal-property-subtitle');
      if (pid && id) pid.value = id;
      if (st && title) st.textContent = 'Unit: ' + title;
      m.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
    }
  };
</script>
