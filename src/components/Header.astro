---
import { BRAND, NAV_LINKS } from '../lib/constants';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 w-full bg-navy-950/95 backdrop-blur-md border-b border-navy-800 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Corporate Brand Identity -->
      <a href="/" class="flex items-center space-x-3.5 group">
        <div class="w-11 h-11 rounded-lg bg-navy-900 border border-gold-400/40 flex items-center justify-center text-gold-400 group-hover:border-gold-400 transition-colors shadow-sm">
          <span class="font-serif font-bold text-sm tracking-widest text-gold-300">I&amp;G</span>
        </div>
        <div>
          <span class="block text-lg font-serif font-bold tracking-wider text-white group-hover:text-gold-300 transition-colors uppercase">
            IVORY &amp; GRACE
          </span>
          <span class="block text-[10px] font-sans font-semibold uppercase tracking-[0.22em] text-gold-400/90">
            PROPERTY &bull; ADVISORY
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden xl:flex items-center space-x-1">
        {NAV_LINKS.map((link) => {
          const isActive = link.href === '/' ? currentPath === '/' : currentPath.startsWith(link.href.split('#')[0]);
          return (
            <a
              href={link.href}
              class={`px-3 py-2 rounded-md text-xs font-medium tracking-wide transition-all ${
                isActive
                  ? 'text-gold-400 bg-navy-900 border border-gold-400/20 font-semibold'
                  : 'text-slate-300 hover:text-white hover:bg-navy-900/60'
              }`}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <!-- Action CTA Buttons (Desktop) -->
      <div class="hidden md:flex items-center space-x-3">
        <a
          href={`https://wa.me/${BRAND.whatsapp}?text=Halo%20Tim%20Ivory%20%26%20Grace%20Property,%20kami%20ingin%20berkonsultasi%20mengenai%20layanan%20properti`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-4 py-2 border border-gold-400/80 rounded-md text-xs font-semibold uppercase tracking-wider text-gold-300 bg-gold-400/10 hover:bg-gold-400 hover:text-navy-950 transition-all duration-200 shadow-sm"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 mr-2 text-gold-400 group-hover:text-navy-950" fill="currentColor" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          Konsultasi Tim
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex items-center xl:hidden">
        <button
          id="mobile-menu-button"
          type="button"
          aria-label="Toggle Mobile Menu"
          class="inline-flex items-center justify-center p-2 rounded-md text-slate-300 hover:text-white hover:bg-navy-900 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-gold-400"
        >
          <svg class="h-6 w-6 block" id="menu-icon-open" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="h-6 w-6 hidden" id="menu-icon-close" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden xl:hidden border-t border-navy-800 bg-navy-950 px-4 pt-3 pb-6 space-y-2">
    {NAV_LINKS.map((link) => {
      const isActive = link.href === '/' ? currentPath === '/' : currentPath.startsWith(link.href.split('#')[0]);
      return (
        <a
          href={link.href}
          class={`block px-3 py-2.5 rounded-md text-sm font-medium ${
            isActive
              ? 'text-gold-400 bg-navy-900 font-semibold'
              : 'text-slate-300 hover:text-white hover:bg-navy-900/50'
          }`}
        >
          {link.label}
        </a>
      );
    })}
    <div class="pt-4 border-t border-navy-800">
      <a
        href={`https://wa.me/${BRAND.whatsapp}?text=Halo%20Tim%20Ivory%20%26%20Grace%20Property,%20kami%20ingin%20berkonsultasi%20mengenai%20layanan%20properti`}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full flex items-center justify-center px-4 py-3 rounded-md text-xs uppercase tracking-wider font-bold text-navy-950 bg-gold-400 hover:bg-gold-300 transition-colors"
      >
        Konsultasi Langsung via WhatsApp
      </a>
    </div>
  </div>
</header>

<script>
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (button && menu && iconOpen && iconClose) {
    button.addEventListener('click', () => {
      const isHidden = menu.classList.contains('hidden');
      if (isHidden) {
        menu.classList.remove('hidden');
        iconOpen.classList.add('hidden');
        iconClose.classList.remove('hidden');
      } else {
        menu.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      }
    });
  }
</script>
