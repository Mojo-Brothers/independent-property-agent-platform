---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BRAND } from '../lib/constants';
---

<BaseLayout
  title={`Halaman Tidak Ditemukan (404) – ${BRAND.name}`}
  description="Halaman yang Anda tuju tidak tersedia atau telah dipindahkan."
>
  <section class="min-h-[70vh] flex items-center justify-center py-20 bg-slate-50">
    <div class="max-w-md mx-auto px-4 text-center">
      <div class="w-20 h-20 rounded-2xl bg-navy-950 text-gold-400 mx-auto flex items-center justify-center font-mono font-bold text-3xl shadow-xl mb-6">
        404
      </div>
      <h1 class="text-2xl font-bold text-navy-950">Halaman Tidak Ditemukan</h1>
      <p class="text-xs sm:text-sm text-slate-600 mt-2 leading-relaxed">
        Maaf, tautan properti atau halaman yang Anda cari mungkin telah diperbarui, dialihkan, atau sudah tidak tersedia.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href="/"
          class="w-full sm:w-auto px-6 py-3 rounded-lg bg-navy-950 hover:bg-navy-900 text-gold-300 font-bold text-xs uppercase tracking-wider transition-colors"
        >
          Kembali ke Beranda
        </a>
        <a
          href="/properties"
          class="w-full sm:w-auto px-6 py-3 rounded-lg bg-white hover:bg-slate-100 text-slate-800 font-semibold text-xs border border-slate-300 transition-colors"
        >
          Lihat Katalog Properti
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
