---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InquiryModal from '../../components/InquiryModal.astro';
import { DEMO_PROPERTIES } from '../../data/mockProperties';
import { BRAND } from '../../lib/constants';

const { slug } = Astro.params;
const property = DEMO_PROPERTIES.find((p) => p.slug === slug);

// If property is not found, redirect or 404
if (!property) {
  return Astro.redirect('/404');
}

const coverImage = property.images.find((i) => i.is_cover) || property.images[0];
---

<BaseLayout
  title={`${property.title} – ${property.price_display} | ${BRAND.name}`}
  description={`${property.description.slice(0, 160)}... Lokasi: ${property.location_district}, ${property.location_city}.`}
  image={coverImage?.image_url}
  type="article"
>
  <!-- Breadcrumb -->
  <div class="bg-slate-100 border-b border-slate-200 py-3 text-xs text-slate-500">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center space-x-2">
      <a href="/" class="hover:text-gold-600 transition-colors">Beranda</a>
      <span>/</span>
      <a href="/properties" class="hover:text-gold-600 transition-colors">Katalog Properti</a>
      <span>/</span>
      <span class="text-navy-950 font-medium truncate">{property.title}</span>
    </div>
  </div>

  <!-- Detail Content Section -->
  <section class="py-10 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Top Title & Badge Header -->
      <div class="mb-8">
        <div class="flex flex-wrap items-center gap-2 mb-2">
          {property.is_demo && (
            <span class="inline-flex items-center px-2.5 py-1 rounded text-xs font-bold bg-amber-500 text-navy-950 tracking-wider">
              DEMO / PORTFOLIO PREVIEW
            </span>
          )}
          <span class="inline-flex items-center px-2.5 py-1 rounded text-xs font-medium bg-navy-950 text-gold-300">
            {property.property_type}
          </span>
          <span class="inline-flex items-center px-2.5 py-1 rounded text-xs font-medium bg-white text-slate-700 border border-slate-300">
            {property.listing_type}
          </span>
          <span class="inline-flex items-center px-2.5 py-1 rounded text-xs font-medium bg-emerald-50 text-emerald-800 border border-emerald-300">
            Sertifikat: {property.certificate_type}
          </span>
        </div>

        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-navy-950 tracking-tight">
          {property.title}
        </h1>

        <div class="flex items-center text-xs sm:text-sm text-slate-500 mt-2">
          <svg class="w-4 h-4 mr-1 text-gold-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span>{property.address_short} ({property.location_district}, {property.location_city})</span>
        </div>
      </div>

      <!-- Main Layout: 2 Columns (Gallery & Details + Sticky Sidebar) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Left Column: Gallery, Specs, Units, Description (Col 8) -->
        <div class="lg:col-span-8 space-y-8">
          
          <!-- Photo Gallery Showcase -->
          <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm space-y-3">
            <div class="aspect-[16/10] w-full rounded-xl overflow-hidden bg-navy-950 relative">
              <img
                id="main-gallery-image"
                src={coverImage?.image_url}
                alt={coverImage?.alt_text || property.title}
                class="w-full h-full object-cover transition-opacity duration-300"
              />
              <div class="absolute bottom-3 left-3 bg-navy-950/80 backdrop-blur-sm text-white px-3 py-1 rounded text-xs">
                Foto {property.images.length > 1 ? '1 dari ' + property.images.length : 'Utama'}
              </div>
            </div>

            <!-- Thumbnail Selector -->
            {property.images.length > 1 && (
              <div class="grid grid-cols-3 sm:grid-cols-4 gap-2 pt-2">
                {property.images.map((img) => (
                  <button
                    type="button"
                    class="aspect-[16/10] rounded-lg overflow-hidden border-2 border-transparent hover:border-gold-400 focus:border-gold-400 transition-all thumbnail-btn"
                    data-img-src={img.image_url}
                    data-img-alt={img.alt_text}
                  >
                    <img src={img.thumbnail_url || img.image_url} alt={img.alt_text} class="w-full h-full object-cover" />
                  </button>
                ))}
              </div>
            )}
          </div>

          <!-- Technical Specifications Matrix -->
          <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-sm">
            <h2 class="text-lg font-bold text-navy-950 mb-4 pb-2 border-b border-slate-100 flex items-center justify-between">
              <span>Spesifikasi Teknis Unit</span>
              <span class="text-xs font-normal text-slate-500 font-mono">ID: {property.id}</span>
            </h2>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs">
              <div class="p-3 bg-slate-50 rounded-lg border border-slate-100">
                <span class="block text-slate-400 uppercase font-medium text-[10px]">Luas Tanah (LT)</span>
                <span class="text-sm font-bold text-navy-950">{property.land_area_sqm} m²</span>
              </div>
              <div class="p-3 bg-slate-50 rounded-lg border border-slate-100">
                <span class="block text-slate-400 uppercase font-medium text-[10px]">Luas Bangunan (LB)</span>
                <span class="text-sm font-bold text-navy-950">{property.building_area_sqm} m²</span>
              </div>
              <div class="p-3 bg-slate-50 rounded-lg border border-slate-100">
                <span class="block text-slate-400 uppercase font-medium text-[10px]">Kamar Tidur</span>
                <span class="text-sm font-bold text-navy-950">{property.bedrooms} Ruang</span>
              </div>
              <div class="p-3 bg-slate-50 rounded-lg border border-slate-100">
                <span class="block text-slate-400 uppercase font-medium text-[10px]">Kamar Mandi</span>
                <span class="text-sm font-bold text-navy-950">{property.bathrooms} Ruang</span>
              </div>
              <div class="p-3 bg-slate-50 rounded-lg border border-slate-100">
                <span class="block text-slate-400 uppercase font-medium text-[10px]">Jumlah Lantai</span>
                <span class="text-sm font-bold text-navy-950">{property.floors} Lantai</span>
              </div>
              <div class="p-3 bg-slate-50 rounded-lg border border-slate-100">
                <span class="block text-slate-400 uppercase font-medium text-[10px]">Kapasitas Carport</span>
                <span class="text-sm font-bold text-navy-950">{property.carports} Mobil</span>
              </div>
              <div class="p-3 bg-slate-50 rounded-lg border border-slate-100">
                <span class="block text-slate-400 uppercase font-medium text-[10px]">Daya Listrik</span>
                <span class="text-sm font-bold text-navy-950">{property.electricity_va} VA</span>
              </div>
              <div class="p-3 bg-slate-50 rounded-lg border border-slate-100">
                <span class="block text-slate-400 uppercase font-medium text-[10px]">Sumber Air Bersih</span>
                <span class="text-sm font-bold text-navy-950">{property.water_source}</span>
              </div>
            </div>
          </div>

          <!-- Detailed Description -->
          <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-sm space-y-4">
            <h2 class="text-lg font-bold text-navy-950 pb-2 border-b border-slate-100">
              Deskripsi & Keunggulan Properti
            </h2>
            <p class="text-sm text-slate-700 leading-relaxed whitespace-pre-line">
              {property.description}
            </p>
          </div>

          <!-- Unit Inventory & Availability Matrix -->
          {property.units && property.units.length > 0 && (
            <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-sm">
              <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-4">
                <div>
                  <h2 class="text-lg font-bold text-navy-950">Matriks Ketersediaan Stok Unit</h2>
                  <p class="text-xs text-slate-500">Pembaruan inventori fisik terkini</p>
                </div>
                <div class="text-xs text-slate-400">
                  Verifikasi: <strong class="text-slate-700">{property.last_inventory_verified_at}</strong>
                </div>
              </div>

              <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                  <thead class="bg-slate-50 text-slate-700 uppercase font-bold text-[10px] tracking-wider border-b border-slate-200">
                    <tr>
                      <th class="py-3 px-3">No. Unit</th>
                      <th class="py-3 px-3">Blok / Sektor</th>
                      <th class="py-3 px-3">Harga Indikatif</th>
                      <th class="py-3 px-3">Status Fisik</th>
                      <th class="py-3 px-3">Aksi</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100">
                    {property.units.map((unit) => {
                      const isAvailable = unit.status === 'Available';
                      const isReserved = unit.status === 'Reserved';
                      const isSold = unit.status === 'Sold';
                      return (
                        <tr class="hover:bg-slate-50/80 transition-colors">
                          <td class="py-3 px-3 font-bold text-navy-950">{unit.unit_number}</td>
                          <td class="py-3 px-3 text-slate-600">{unit.block}</td>
                          <td class="py-3 px-3 font-semibold text-slate-800">
                            Rp {(unit.price / 1000000).toLocaleString('id-ID')} Juta
                          </td>
                          <td class="py-3 px-3">
                            <span class={`inline-block px-2 py-0.5 rounded text-[10px] font-bold ${
                              isAvailable ? 'bg-emerald-100 text-emerald-800' :
                              isReserved ? 'bg-amber-100 text-amber-800' :
                              isSold ? 'bg-rose-100 text-rose-800' : 'bg-slate-100 text-slate-600'
                            }`}>
                              {unit.status}
                            </span>
                          </td>
                          <td class="py-3 px-3">
                            {isAvailable ? (
                              <button
                                type="button"
                                onclick={`window.openInquiryModal('${property.id}', '${property.title} - Unit ${unit.unit_number}')`}
                                class="text-gold-700 hover:text-gold-900 font-bold underline text-[11px]"
                              >
                                Booking / Tanya
                              </button>
                            ) : (
                              <span class="text-slate-400 text-[11px]">Tidak Tersedia</span>
                            )}
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            </div>
          )}

          <!-- Disclaimer Notice Box -->
          <div class="p-4 rounded-xl bg-slate-100 border border-slate-200 text-xs text-slate-500">
            <strong>Pernyataan Keterbukaan:</strong> Seluruh informasi harga, spesifikasi, dan ketersediaan unit di atas merupakan data acuan berdasarkan verifikasi tanggal {property.last_inventory_verified_at}. Mohon melakukan konfirmasi ulang dengan Robby Viory Fansya sebelum melakukan pembayaran uang muka / tanda jadi.
          </div>

        </div>

        <!-- Right Column: Sticky Pricing & Action Card (Col 4) -->
        <div class="lg:col-span-4 sticky top-24 space-y-6">
          
          <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-lg space-y-6">
            
            <div class="border-b border-slate-100 pb-4">
              <span class="text-xs uppercase font-semibold text-slate-400 tracking-wider">Harga Resmi</span>
              <p class="text-3xl font-extrabold text-navy-950 mt-1 text-gold-700">
                {property.price_display}
              </p>
              <p class="text-xs text-slate-500 mt-1">
                *Bebas biaya konsultasi & perantara bagi pembeli
              </p>
            </div>

            <!-- Direct Contact CTAs -->
            <div class="space-y-3">
              <button
                type="button"
                id="btn-open-inquiry"
                onclick={`window.openInquiryModal('${property.id}', '${property.title}')`}
                class="w-full py-3.5 px-4 rounded-lg bg-navy-950 hover:bg-navy-900 text-gold-300 font-bold text-xs uppercase tracking-wider transition-colors shadow-sm flex items-center justify-center space-x-2"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                </svg>
                <span>Ajukan Inquiry / KPR Unit</span>
              </button>

              <a
                href={`https://wa.me/${BRAND.whatsapp}?text=Halo%20Bpk.%20Robby%20Viory%20Fansya,%20saya%20ingin%20jadwal%20survey%20lokasi%20untuk%20properti:%20${encodeURIComponent(property.title)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full py-3.5 px-4 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs uppercase tracking-wider transition-colors shadow-sm flex items-center justify-center space-x-2"
              >
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                </svg>
                <span>Jadwalkan Survey via WhatsApp</span>
              </a>
            </div>

            <!-- Agent Contact Info Box -->
            <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 space-y-2 text-xs">
              <span class="block font-bold text-navy-950 uppercase tracking-wider text-[10px]">
                Konsultan Pendamping Resmi:
              </span>
              <p class="font-bold text-navy-900 text-sm">{BRAND.name}</p>
              <p class="text-gold-700 font-semibold">{BRAND.title}</p>
              <p class="text-slate-500">WhatsApp: {BRAND.phone}</p>
              <p class="text-slate-500">Email: {BRAND.email}</p>
            </div>

          </div>

        </div>

      </div>

    </div>
  </section>

  <InquiryModal propertyId={property.id} propertyTitle={property.title} />
</BaseLayout>

<script>
  // Image gallery switcher
  const mainImage = document.getElementById('main-gallery-image') as HTMLImageElement;
  const thumbnails = document.querySelectorAll('.thumbnail-btn');

  thumbnails.forEach((btn) => {
    btn.addEventListener('click', () => {
      const src = btn.getAttribute('data-img-src');
      const alt = btn.getAttribute('data-img-alt');
      if (mainImage && src) {
        mainImage.style.opacity = '0.3';
        setTimeout(() => {
          mainImage.src = src;
          if (alt) mainImage.alt = alt;
          mainImage.style.opacity = '1';
        }, 150);
      }
    });
  });
</script>
