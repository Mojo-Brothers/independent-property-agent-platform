---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BRAND } from '../lib/constants';
---

<BaseLayout
  title={`Kontak & Konsultasi Properti – ${BRAND.name}`}
  description={`Hubungi Robby Viory Fansya, Independent Property Agent untuk konsultasi hunian, survey lokasi, atau pengajuan kemitraan developer di Bekasi & Cikarang.`}
>
  <!-- Header -->
  <section class="bg-navy-950 text-white py-16 border-b border-navy-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="text-xs font-semibold uppercase tracking-widest text-gold-400">
          Saluran Komunikasi
        </span>
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white mt-2">
          Kontak & Konsultasi Properti
        </h1>
        <p class="text-slate-300 text-sm sm:text-base mt-3 leading-relaxed">
          Silakan hubungi kami untuk mendiskusikan kebutuhan hunian, penjadwalan survey unit, atau pembahasan kemitraan pemasaran pengembang.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Grid Section -->
  <section class="py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Left Column: Contact Channels & Office Info (Col 5) -->
        <div class="lg:col-span-5 space-y-6">
          
          <div class="bg-white rounded-2xl p-8 border border-slate-200 shadow-sm space-y-6">
            <h2 class="text-xl font-bold text-navy-950 pb-3 border-b border-slate-100">
              Kanal Komunikasi Resmi
            </h2>

            <!-- WhatsApp Direct -->
            <div class="flex items-start space-x-4">
              <div class="w-10 h-10 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                </svg>
              </div>
              <div>
                <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider">WhatsApp Konsultasi</span>
                <a
                  href={`https://wa.me/${BRAND.whatsapp}?text=Halo%20Bpk.%20Robby%20Viory%20Fansya,%20saya%20ingin%20berkonsultasi`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-base font-bold text-navy-950 hover:text-emerald-600 transition-colors"
                >
                  {BRAND.phone}
                </a>
                <p class="text-xs text-slate-500 mt-0.5">Respon cepat via pesan teks / voice note.</p>
              </div>
            </div>

            <!-- Email -->
            <div class="flex items-start space-x-4">
              <div class="w-10 h-10 rounded-lg bg-navy-100 text-navy-900 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider">Email Korespondensi</span>
                <a href={`mailto:${BRAND.email}`} class="text-base font-bold text-navy-950 hover:text-gold-600 transition-colors">
                  {BRAND.email}
                </a>
                <p class="text-xs text-slate-500 mt-0.5">Untuk pengiriman proposal resmi & dokumen kemitraan.</p>
              </div>
            </div>

            <!-- Operational Hours -->
            <div class="flex items-start space-x-4">
              <div class="w-10 h-10 rounded-lg bg-gold-100 text-gold-800 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider">Jam Layanan Konsultasi</span>
                <p class="text-sm font-bold text-navy-950">Senin - Minggu: 08.00 - 20.00 WIB</p>
                <p class="text-xs text-slate-500 mt-0.5">Survey lokasi dilakukan sesuai perjanjian tertulis.</p>
              </div>
            </div>

            <!-- Office Location -->
            <div class="flex items-start space-x-4">
              <div class="w-10 h-10 rounded-lg bg-slate-100 text-slate-700 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider">Wilayah Operasional</span>
                <p class="text-xs text-slate-700 mt-1 leading-relaxed">
                  {BRAND.address}
                </p>
              </div>
            </div>

          </div>

          <div class="bg-navy-950 text-white rounded-2xl p-6 border border-gold-400/30 text-xs space-y-2">
            <p class="font-bold text-gold-400">Jadwal Survey Properti:</p>
            <p class="text-slate-300 leading-relaxed">
              Untuk kenyamanan Anda dan kesiapan perizinan akses show unit di lokasi proyek pengembang, mohon menjadwalkan survey minimal 1 (satu) hari sebelumnya melalui WhatsApp.
            </p>
          </div>

        </div>

        <!-- Right Column: Direct Consultation Form (Col 7) -->
        <div class="lg:col-span-7">
          <div class="bg-white rounded-2xl p-8 sm:p-10 border border-slate-200 shadow-sm">
            
            <div class="mb-6">
              <span class="text-xs font-bold text-gold-700 uppercase tracking-widest block">
                Formulir Konsultasi Langsung
              </span>
              <h2 class="text-2xl font-bold text-navy-950 mt-1">
                Kirim Pesan atau Pertanyaan Anda
              </h2>
              <p class="text-xs text-slate-500 mt-1">
                Isi formulir di bawah ini dan Robby Viory Fansya akan menghubungi Anda kembali.
              </p>
            </div>

            <form id="contact-page-form" class="space-y-4">
              <div>
                <label for="contact-name" class="block text-xs font-semibold text-slate-700 mb-1">
                  Nama Lengkap <span class="text-rose-500">*</span>
                </label>
                <input
                  type="text"
                  id="contact-name"
                  name="full_name"
                  required
                  placeholder="Nama Anda"
                  class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-gold-400 focus:border-gold-400 outline-none"
                />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="contact-phone" class="block text-xs font-semibold text-slate-700 mb-1">
                    Nomor WhatsApp <span class="text-rose-500">*</span>
                  </label>
                  <input
                    type="tel"
                    id="contact-phone"
                    name="phone_whatsapp"
                    required
                    placeholder="0812xxxxxxxx"
                    class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-gold-400 focus:border-gold-400 outline-none"
                  />
                </div>
                <div>
                  <label for="contact-email" class="block text-xs font-semibold text-slate-700 mb-1">
                    Email
                  </label>
                  <input
                    type="email"
                    id="contact-email"
                    name="email"
                    placeholder="nama@email.com"
                    class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-gold-400 focus:border-gold-400 outline-none"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="contact-budget" class="block text-xs font-semibold text-slate-700 mb-1">
                    Estimasi Budget <span class="text-rose-500">*</span>
                  </label>
                  <select
                    id="contact-budget"
                    name="budget_range"
                    required
                    class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-gold-400 focus:border-gold-400 outline-none bg-white"
                  >
                    <option value="">Pilih Alokasi Budget</option>
                    <option value="Di bawah Rp 500 Juta">&lt; Rp 500 Juta</option>
                    <option value="Rp 500 Juta - Rp 1 Miliar">Rp 500 Juta - Rp 1 Miliar</option>
                    <option value="Rp 1 Miliar - Rp 2 Miliar">Rp 1 Miliar - Rp 2 Miliar</option>
                    <option value="Di atas Rp 2 Miliar">&gt; Rp 2 Miliar</option>
                  </select>
                </div>
                <div>
                  <label for="contact-purpose" class="block text-xs font-semibold text-slate-700 mb-1">
                    Kebutuhan <span class="text-rose-500">*</span>
                  </label>
                  <select
                    id="contact-purpose"
                    name="purchase_purpose"
                    required
                    class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-gold-400 focus:border-gold-400 outline-none bg-white"
                  >
                    <option value="Tempat Tinggal Pribadi">Cari Hunian Pribadi</option>
                    <option value="Investasi Sewa">Investasi / Sewa</option>
                    <option value="Pilihan Pertama Anak">Rumah Anak Pertama</option>
                    <option value="Lainnya">Lainnya / Diskusi Proyek</option>
                  </select>
                </div>
              </div>

              <div>
                <label for="contact-msg" class="block text-xs font-semibold text-slate-700 mb-1">
                  Pesan atau Kriteria Properti yang Dicari
                </label>
                <textarea
                  id="contact-msg"
                  name="message"
                  rows="4"
                  placeholder="Contoh: Sedang mencari rumah 2 lantai siap huni di area Cikarang Selatan dengan budget sekitar 900 jutaan..."
                  class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-gold-400 focus:border-gold-400 outline-none"
                ></textarea>
              </div>

              <div class="flex items-start space-x-2 pt-1">
                <input
                  type="checkbox"
                  id="contact-consent"
                  name="consent_agreed"
                  required
                  checked
                  class="mt-1 h-4 w-4 text-gold-500 focus:ring-gold-400 border-slate-300 rounded"
                />
                <label for="contact-consent" class="text-[11px] text-slate-500 leading-normal">
                  Saya menyetujui data di atas digunakan untuk keperluan korespondensi properti sesuai <a href="/privacy-policy" class="text-gold-600 underline">Kebijakan Privasi</a>.
                </label>
              </div>

              <div id="contact-feedback" class="hidden text-xs p-3 rounded-lg"></div>

              <div class="pt-2">
                <button
                  type="submit"
                  id="contact-submit-btn"
                  class="w-full py-3.5 px-6 bg-navy-950 hover:bg-navy-900 text-gold-300 font-semibold text-sm rounded-lg shadow-md transition-all flex items-center justify-center space-x-2"
                >
                  <span>Kirim Pesan Konsultasi</span>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </button>
              </div>
            </form>

          </div>
        </div>

      </div>

    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('contact-page-form') as HTMLFormElement;
  const feedback = document.getElementById('contact-feedback');
  const btn = document.getElementById('contact-submit-btn');

  if (form && feedback && btn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      btn.setAttribute('disabled', 'true');
      btn.classList.add('opacity-70');
      feedback.classList.remove('hidden', 'bg-rose-50', 'text-rose-700', 'bg-emerald-50', 'text-emerald-700');
      feedback.classList.add('bg-slate-100', 'text-slate-700');
      feedback.textContent = 'Mengirim pesan...';

      const formData = new FormData(form);
      const payload = {
        full_name: formData.get('full_name'),
        phone_whatsapp: formData.get('phone_whatsapp'),
        email: formData.get('email') || undefined,
        budget_range: formData.get('budget_range'),
        purchase_purpose: formData.get('purchase_purpose'),
        message: formData.get('message') || undefined,
        consent_agreed: formData.get('consent_agreed') === 'on',
      };

      try {
        const res = await fetch('/api/inquiries', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const data = await res.json();
        if (res.ok && data.success) {
          feedback.classList.remove('bg-slate-100', 'text-slate-700');
          feedback.classList.add('bg-emerald-50', 'text-emerald-700', 'border', 'border-emerald-200');
          feedback.textContent = data.message;
          form.reset();
        } else {
          feedback.classList.remove('bg-slate-100', 'text-slate-700');
          feedback.classList.add('bg-rose-50', 'text-rose-700', 'border', 'border-rose-200');
          feedback.textContent = data.message || 'Gagal mengirim pesan. Silakan hubungi via WhatsApp.';
        }
      } catch (err) {
        feedback.classList.remove('bg-slate-100', 'text-slate-700');
        feedback.classList.add('bg-rose-50', 'text-rose-700', 'border', 'border-rose-200');
        feedback.textContent = 'Terjadi kesalahan sistem. Silakan hubungi via WhatsApp langsung.';
      } finally {
        btn.removeAttribute('disabled');
        btn.classList.remove('opacity-70');
      }
    });
  }
</script>
