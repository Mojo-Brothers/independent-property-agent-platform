---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import PropertyCard from '../components/PropertyCard.astro';
import InquiryModal from '../components/InquiryModal.astro';
import { DEMO_PROPERTIES } from '../data/mockProperties';
import { BRAND } from '../lib/constants';

const featuredProperties = DEMO_PROPERTIES.filter((p) => p.is_featured);
---

<BaseLayout>
  <!-- 1. Hero Section -->
  <HeroSection />

  <!-- 2. Strategic Value Proposition Bar -->
  <section class="bg-white border-b border-slate-200/80 py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6 text-center md:text-left">
        
        <div class="flex items-center space-x-4 p-4 rounded-xl bg-[#FAF9F5] border border-slate-200/70">
          <div class="w-12 h-12 rounded-lg bg-navy-950 text-gold-400 flex items-center justify-center flex-shrink-0 font-bold font-serif text-sm">
            01
          </div>
          <div>
            <h4 class="text-sm font-bold text-navy-950">Evidence-Based</h4>
            <p class="text-xs text-slate-500">Data listing riil, tanpa spekulasi atau klaim fiktif.</p>
          </div>
        </div>

        <div class="flex items-center space-x-4 p-4 rounded-xl bg-[#FAF9F5] border border-slate-200/70">
          <div class="w-12 h-12 rounded-lg bg-navy-950 text-gold-400 flex items-center justify-center flex-shrink-0 font-bold font-serif text-sm">
            02
          </div>
          <div>
            <h4 class="text-sm font-bold text-navy-950">Developer Sinergi</h4>
            <p class="text-xs text-slate-500">Harga resmi langsung dari pengembang tanpa markup.</p>
          </div>
        </div>

        <div class="flex items-center space-x-4 p-4 rounded-xl bg-[#FAF9F5] border border-slate-200/70">
          <div class="w-12 h-12 rounded-lg bg-navy-950 text-gold-400 flex items-center justify-center flex-shrink-0 font-bold font-serif text-sm">
            03
          </div>
          <div>
            <h4 class="text-sm font-bold text-navy-950">Legalitas Teruji</h4>
            <p class="text-xs text-slate-500">Pemeriksaan sertifikat, IMB/PBG, dan riwayat perizinan.</p>
          </div>
        </div>

        <div class="flex items-center space-x-4 p-4 rounded-xl bg-[#FAF9F5] border border-slate-200/70">
          <div class="w-12 h-12 rounded-lg bg-navy-950 text-gold-400 flex items-center justify-center flex-shrink-0 font-bold font-serif text-sm">
            04
          </div>
          <div>
            <h4 class="text-sm font-bold text-navy-950">Pendampingan KPR</h4>
            <p class="text-xs text-slate-500">Konsultasi pra-kualifikasi perbankan hingga akad kredit.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 3. Featured Property Portfolio -->
  <section class="py-16 sm:py-20 bg-[#FAF9F5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div>
          <div class="inline-flex items-center space-x-2 text-xs font-bold text-gold-700 uppercase tracking-widest mb-2">
            <span>Portfolio Unggulan</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-serif font-extrabold text-navy-950 tracking-tight">
            Properti &amp; Cluster Pilihan Terkini
          </h2>
          <p class="text-sm text-slate-600 mt-2 max-w-xl">
            Unit residensial dan komersial dengan status stok terverifikasi di koridor pertumbuhan Bekasi, Cikarang, dan koridor strategis Jabodetabek.
          </p>
        </div>
        <div class="mt-4 md:mt-0">
          <a
            href="/properties"
            class="inline-flex items-center text-xs font-bold uppercase tracking-wider text-navy-950 hover:text-gold-600 transition-colors"
          >
            <span>Lihat Semua Katalog Listing</span>
            <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Properties Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {featuredProperties.map((property) => (
          <PropertyCard property={property} />
        ))}
      </div>

      <!-- Demo Disclaimer Banner -->
      <div class="mt-10 p-4 rounded-xl bg-amber-50 border border-amber-200/80 text-xs text-amber-900 flex items-center justify-between flex-wrap gap-2">
        <span class="flex items-center font-medium">
          <svg class="w-4 h-4 mr-2 text-amber-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Label <strong>DEMO</strong> menandai unit representasi portofolio arsitektural. Seluruh ketersediaan stok fisik dan harga acuan wajib dikonfirmasi terlebih dahulu.
        </span>
        <a href="/properties" class="font-bold underline text-amber-950 hover:text-amber-800">
          Filter Sesuai Kriteria Anda →
        </a>
      </div>

    </div>
  </section>

  <!-- 4. Institutional Advisory Value Proposition -->
  <section class="py-16 sm:py-20 bg-navy-950 text-white relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <div class="max-w-3xl mx-auto text-center space-y-4 mb-16">
        <span class="text-xs font-semibold text-gold-400 uppercase tracking-widest">
          {BRAND.parentBrand} &bull; Property Advisory
        </span>
        <h2 class="text-3xl sm:text-4xl font-serif font-extrabold tracking-tight">
          Pendekatan Pemasaran &amp; Penasihat Properti Institusional
        </h2>
        <p class="text-slate-300 text-sm leading-relaxed font-light">
          Sebagai lini bisnis pemasaran dan penasihat properti profesional, {BRAND.name} mengedepankan objektivitas data pasar, keterbukaan legalitas, dan eksekusi pemasaran digital presisi demi melindungi nilai investasi jangka panjang setiap pihak.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <div class="bg-navy-900/80 border border-navy-800 p-8 rounded-2xl space-y-4">
          <div class="w-12 h-12 rounded-xl bg-navy-950 border border-gold-400/40 text-gold-400 flex items-center justify-center font-serif font-bold text-lg">
            A
          </div>
          <h3 class="text-lg font-bold font-serif text-white">Analisis Pasar Objektif</h3>
          <p class="text-slate-300 text-xs leading-relaxed">
            Tidak terikat pada satu developer semata, memungkinkan pemberian rekomendasi perbandingan yang jujur terkait plus-minus lokasi, reputasi developer, dan potensi apresiasi modal.
          </p>
        </div>

        <div class="bg-navy-900/80 border border-navy-800 p-8 rounded-2xl space-y-4">
          <div class="w-12 h-12 rounded-xl bg-navy-950 border border-gold-400/40 text-gold-400 flex items-center justify-center font-serif font-bold text-lg">
            B
          </div>
          <h3 class="text-lg font-bold font-serif text-white">Digital Marketing Terukur</h3>
          <p class="text-slate-300 text-xs leading-relaxed">
            Menerapkan strategi pemasaran digital presisi tinggi (targeted performance ads, SEO platform, visual storytelling) untuk menjangkau pembeli kualifikasi tinggi secara efisien.
          </p>
        </div>

        <div class="bg-navy-900/80 border border-navy-800 p-8 rounded-2xl space-y-4">
          <div class="w-12 h-12 rounded-xl bg-navy-950 border border-gold-400/40 text-gold-400 flex items-center justify-center font-serif font-bold text-lg">
            C
          </div>
          <h3 class="text-lg font-bold font-serif text-white">Dedicated Advisory Team</h3>
          <p class="text-slate-300 text-xs leading-relaxed">
            Satu pintu koordinasi bersama tim konsultan: dari konsultasi kebutuhan awal, penjadwalan survey unit, negosiasi skema pembayaran, hingga pendampingan serah terima kunci.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- 5. Developer & Property Owners Strategic Partnership -->
  <section class="py-16 sm:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="bg-gradient-to-br from-navy-950 via-navy-900 to-navy-850 rounded-3xl p-8 sm:p-14 text-white shadow-xl relative overflow-hidden border border-gold-400/20">
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          
          <div class="lg:col-span-8 space-y-4">
            <span class="inline-block px-3 py-1 rounded bg-gold-400/20 text-gold-300 text-xs font-semibold uppercase tracking-wider">
              Developer &amp; Property Owners Partnership
            </span>
            <h2 class="text-2xl sm:text-3xl font-serif font-extrabold tracking-tight">
              Akselerasikan Penyerapan Properti Anda Bersama Tim Kami
            </h2>
            <p class="text-sm text-slate-300 leading-relaxed max-w-2xl font-light">
              Kami membuka peluang kerja sama pemasaran formal dengan pengembang perumahan, kawasan cluster swasta, instansi pengembang, maupun pemilik aset properti sekunder dan komersial terkurasi. Dapatkan pelaporan prospek terstruktur dan kampanye pemasaran digital terarah.
            </p>
            <div class="flex flex-wrap gap-3 pt-2 text-xs text-gold-300">
              <span class="bg-navy-950/80 px-3 py-1.5 rounded border border-navy-700">✓ Sistem Pelaporan Leads CRM</span>
              <span class="bg-navy-950/80 px-3 py-1.5 rounded border border-navy-700">✓ Presentasi Kemitraan Resmi</span>
              <span class="bg-navy-950/80 px-3 py-1.5 rounded border border-navy-700">✓ Sinergi Co-Brokering &amp; Exclusive Agency</span>
            </div>
          </div>

          <div class="lg:col-span-4 flex flex-col space-y-3">
            <a
              href="/developer-partnership"
              class="w-full py-3.5 px-6 rounded-lg bg-gold-400 hover:bg-gold-300 text-navy-950 font-bold text-center text-xs uppercase tracking-wider shadow-gold-glow transition-all"
            >
              Pelajari Konsep Kemitraan
            </a>
            <a
              href="/contact"
              class="w-full py-3.5 px-6 rounded-lg bg-navy-950 hover:bg-navy-900 text-white font-semibold text-center text-xs uppercase tracking-wider border border-navy-700 transition-all"
            >
              Jadwalkan Diskusi / Pertemuan
            </a>
          </div>

        </div>

      </div>

    </div>
  </section>

  <!-- 6. Property Consultation CTA Bar -->
  <section class="py-12 bg-slate-100 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <h3 class="text-xl sm:text-2xl font-serif font-bold text-navy-950">
        Mencari Hunian, Aset Komersial, atau Merencanakan Investasi Properti?
      </h3>
      <p class="text-xs sm:text-sm text-slate-600 max-w-2xl mx-auto">
        Diskusikan preferensi lokasi, portofolio perumahan, atau simulasi KPR bersama Tim {BRAND.name}. Bebas biaya konsultasi bagi calon pembeli.
      </p>
      <div class="pt-2">
        <a
          href={`https://wa.me/${BRAND.whatsapp}?text=Halo%20Tim%20Ivory%20%26%20Grace%20Property,%20kami%20ingin%20berkonsultasi%20mengenai%20portofolio%20properti`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center px-6 py-3 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs uppercase tracking-wider shadow-md transition-all"
        >
          <svg class="w-4 h-4 mr-2 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          Chat WhatsApp dengan Tim Konsultan
        </a>
      </div>
    </div>
  </section>

  <!-- Inquiry Modal Component for Fast Interactivity -->
  <InquiryModal />
</BaseLayout>
