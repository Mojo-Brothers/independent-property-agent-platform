---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { DEMO_PROPERTIES } from '../../data/mockProperties';

const token = Astro.cookies.get('ipa_admin_token')?.value;
if (!token) {
  return Astro.redirect('/admin/login');
}

const totalProperties = DEMO_PROPERTIES.length;
const totalUnits = DEMO_PROPERTIES.reduce((acc, p) => acc + (p.units?.length || 0), 0);
const availableUnits = DEMO_PROPERTIES.reduce(
  (acc, p) => acc + (p.units?.filter((u) => u.status === 'Available').length || 0),
  0
);
---

<AdminLayout title="Ringkasan Dashboard" activeNav="overview">
  <div class="space-y-8 max-w-7xl mx-auto">
    
    <!-- Welcome Header Card -->
    <div class="bg-gradient-to-r from-navy-950 via-navy-900 to-navy-850 rounded-2xl p-6 sm:p-8 text-white shadow-md border border-gold-400/20 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="space-y-2">
        <span class="inline-block px-2.5 py-0.5 rounded text-[10px] font-bold bg-gold-400/20 text-gold-300 uppercase tracking-wider">
          Advisory Management System
        </span>
        <h2 class="text-xl sm:text-2xl font-bold font-serif">Selamat Datang di Portal Manajemen IVORY &amp; GRACE PROPERTY</h2>
        <p class="text-xs text-slate-300 max-w-2xl leading-relaxed font-light">
          Kendali operasional pemasaran properti terpadu. Pantau prospek leads masuk, status stok unit, dan permohonan kemitraan pengembang.
        </p>
      </div>

      <div class="flex flex-wrap gap-2 flex-shrink-0">
        <a
          href="/admin/properties"
          class="px-4 py-2.5 rounded-lg bg-gold-400 hover:bg-gold-300 text-navy-950 font-bold text-xs transition-colors shadow-sm"
        >
          + Kelola Properti
        </a>
        <a
          href="/admin/leads"
          class="px-4 py-2.5 rounded-lg bg-navy-800 hover:bg-navy-700 text-white font-semibold text-xs border border-navy-700 transition-colors"
        >
          Lihat Leads CRM
        </a>
      </div>
    </div>

    <!-- Quick Stats Grid (4 Metrics) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      
      <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm space-y-2">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Listing Properti</span>
        <div class="flex items-baseline justify-between">
          <span class="text-3xl font-extrabold text-navy-950">{totalProperties}</span>
          <span class="text-xs font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded">Aktif</span>
        </div>
        <p class="text-[11px] text-slate-400">Bekasi, Cikarang & Tambun</p>
      </div>

      <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm space-y-2">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Unit Tersedia (Stok)</span>
        <div class="flex items-baseline justify-between">
          <span class="text-3xl font-extrabold text-navy-950">{availableUnits}</span>
          <span class="text-xs text-slate-500">dari {totalUnits} unit total</span>
        </div>
        <p class="text-[11px] text-slate-400">Matriks inventori fisik terverifikasi</p>
      </div>

      <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm space-y-2">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Prospek Leads CRM</span>
        <div class="flex items-baseline justify-between">
          <span class="text-3xl font-extrabold text-navy-950">14</span>
          <span class="text-xs font-bold text-gold-700 bg-gold-50 px-2 py-0.5 rounded">6 Follow-up</span>
        </div>
        <p class="text-[11px] text-slate-400">Inquiry dari website & WhatsApp</p>
      </div>

      <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm space-y-2">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Kemitraan Pengembang</span>
        <div class="flex items-baseline justify-between">
          <span class="text-3xl font-extrabold text-navy-950">3</span>
          <span class="text-xs font-bold text-blue-700 bg-blue-50 px-2 py-0.5 rounded">Proposal</span>
        </div>
        <p class="text-[11px] text-slate-400">Pengajuan kemitraan developer</p>
      </div>

    </div>

    <!-- 2 Column Section: Recent Leads & Inventory Overview -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- Recent Leads Pipeline (Col 7) -->
      <div class="lg:col-span-7 bg-white rounded-xl p-6 border border-slate-200 shadow-sm space-y-4">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
          <div>
            <h3 class="text-base font-bold text-navy-950">Aktivitas Prospek Masuk (Leads)</h3>
            <p class="text-xs text-slate-500">Pemberitahuan calon pembeli yang tertarik unit properti</p>
          </div>
          <a href="/admin/leads" class="text-xs font-bold text-gold-700 hover:text-gold-900">
            Buka CRM Penuh →
          </a>
        </div>

        <div class="divide-y divide-slate-100 text-xs">
          <div class="py-3 flex items-center justify-between">
            <div>
              <p class="font-bold text-navy-950">Bpk. Hendra Gunawan</p>
              <p class="text-slate-500">Cluster Grand Asteria Residence • Budget: Rp 500Jt - 1M</p>
            </div>
            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-800">
              New (Baru Masuk)
            </span>
          </div>

          <div class="py-3 flex items-center justify-between">
            <div>
              <p class="font-bold text-navy-950">Ibu Ratna Dewi</p>
              <p class="text-slate-500">Ready Stock Emerald Villa Grand Wisata • Budget: Rp 1M - 2M</p>
            </div>
            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-800">
              Follow Up Survey
            </span>
          </div>

          <div class="py-3 flex items-center justify-between">
            <div>
              <p class="font-bold text-navy-950">Bpk. Dimas Pratama</p>
              <p class="text-slate-500">Urban Heritage Living Harapan Indah • Budget: Rp 500Jt - 1M</p>
            </div>
            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-blue-100 text-blue-800">
              Qualified KPR
            </span>
          </div>
        </div>
      </div>

      <!-- Quick Inventory Snapshot (Col 5) -->
      <div class="lg:col-span-5 bg-white rounded-xl p-6 border border-slate-200 shadow-sm space-y-4">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
          <div>
            <h3 class="text-base font-bold text-navy-950">Status Unit Fisik</h3>
            <p class="text-xs text-slate-500">Komposisi ketersediaan inventori</p>
          </div>
          <a href="/admin/units" class="text-xs font-bold text-gold-700 hover:text-gold-900">
            Matriks Stok →
          </a>
        </div>

        <div class="space-y-3 text-xs">
          <div>
            <div class="flex justify-between font-semibold text-slate-700 mb-1">
              <span>Available (Siap Jual)</span>
              <span class="text-emerald-600 font-bold">{availableUnits} Unit</span>
            </div>
            <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden">
              <div class="h-full bg-emerald-500 rounded-full" style={`width: ${(availableUnits / totalUnits) * 100}%`}></div>
            </div>
          </div>

          <div>
            <div class="flex justify-between font-semibold text-slate-700 mb-1">
              <span>Reserved (Booking Fee Masuk)</span>
              <span class="text-amber-600 font-bold">2 Unit</span>
            </div>
            <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden">
              <div class="h-full bg-amber-500 rounded-full" style="width: 25%"></div>
            </div>
          </div>

          <div>
            <div class="flex justify-between font-semibold text-slate-700 mb-1">
              <span>Sold (Akad Selesai)</span>
              <span class="text-rose-600 font-bold">2 Unit</span>
            </div>
            <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden">
              <div class="h-full bg-rose-500 rounded-full" style="width: 25%"></div>
            </div>
          </div>
        </div>

        <div class="pt-4 border-t border-slate-100 text-[11px] text-slate-400">
          Tanggal Verifikasi Inventori Terkini: <strong class="text-slate-600">19 November 2026</strong>
        </div>
      </div>

    </div>

  </div>
</AdminLayout>
