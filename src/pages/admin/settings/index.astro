---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { BRAND } from '../../../lib/constants';

const token = Astro.cookies.get('ipa_admin_token')?.value;
if (!token) {
  return Astro.redirect('/admin/login');
}
---

<AdminLayout title="Pengaturan Website & SEO" activeNav="settings">
  <div class="space-y-8 max-w-4xl mx-auto">
    
    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
      <h2 class="text-base font-bold text-navy-950">Konfigurasi Identitas & Saluran Kontak</h2>
      <p class="text-xs text-slate-500 mt-1">Data identitas publik yang ditampilkan di seluruh website, footer, dan tautan WhatsApp.</p>
      
      <form id="settings-form" class="mt-6 space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="set-name" class="block text-xs font-semibold text-slate-700 mb-1">Nama Pemilik / Agen</label>
            <input
              type="text"
              id="set-name"
              value={BRAND.name}
              class="w-full px-3.5 py-2 border border-slate-300 rounded-lg text-xs text-navy-950 font-bold focus:ring-2 focus:ring-gold-400 outline-none"
            />
          </div>
          <div>
            <label for="set-title" class="block text-xs font-semibold text-slate-700 mb-1">Gelar Profesional</label>
            <input
              type="text"
              id="set-title"
              value={BRAND.title}
              class="w-full px-3.5 py-2 border border-slate-300 rounded-lg text-xs text-slate-800 focus:ring-2 focus:ring-gold-400 outline-none"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="set-wa" class="block text-xs font-semibold text-slate-700 mb-1">Nomor WhatsApp Resmi (Format: 6281xxx)</label>
            <input
              type="text"
              id="set-wa"
              value={BRAND.whatsapp}
              class="w-full px-3.5 py-2 border border-slate-300 rounded-lg text-xs text-slate-800 font-mono focus:ring-2 focus:ring-gold-400 outline-none"
            />
          </div>
          <div>
            <label for="set-email" class="block text-xs font-semibold text-slate-700 mb-1">Email Resmi</label>
            <input
              type="email"
              id="set-email"
              value={BRAND.email}
              class="w-full px-3.5 py-2 border border-slate-300 rounded-lg text-xs text-slate-800 focus:ring-2 focus:ring-gold-400 outline-none"
            />
          </div>
        </div>

        <div>
          <label for="set-tagline" class="block text-xs font-semibold text-slate-700 mb-1">Tagline Korporat</label>
          <input
            type="text"
            id="set-tagline"
            value={BRAND.tagline}
            class="w-full px-3.5 py-2 border border-slate-300 rounded-lg text-xs text-slate-800 focus:ring-2 focus:ring-gold-400 outline-none"
          />
        </div>

        <div>
          <label for="set-address" class="block text-xs font-semibold text-slate-700 mb-1">Alamat Hub Operasional</label>
          <input
            type="text"
            id="set-address"
            value={BRAND.address}
            class="w-full px-3.5 py-2 border border-slate-300 rounded-lg text-xs text-slate-800 focus:ring-2 focus:ring-gold-400 outline-none"
          />
        </div>

        <div class="pt-4 border-t border-slate-200">
          <h3 class="text-xs font-bold uppercase tracking-wider text-navy-950 mb-3">Pengaturan SEO Global</h3>
          <div class="space-y-3">
            <div>
              <label for="set-meta-desc" class="block text-xs font-semibold text-slate-700 mb-1">Meta Description Default</label>
              <textarea
                id="set-meta-desc"
                rows="3"
                class="w-full px-3.5 py-2 border border-slate-300 rounded-lg text-xs text-slate-700 focus:ring-2 focus:ring-gold-400 outline-none"
              >Platform digital portofolio kemitraan developer dan katalog properti independen Robby Viory Fansya. Menghadirkan listing terverifikasi dan konsultasi hunian di Bekasi dan Cikarang.</textarea>
            </div>
            <div>
              <label for="set-canonical" class="block text-xs font-semibold text-slate-700 mb-1">Canonical Base URL</label>
              <input
                type="url"
                id="set-canonical"
                value="https://robbyvioryfansya.pages.dev"
                class="w-full px-3.5 py-2 border border-slate-300 rounded-lg text-xs text-slate-700 font-mono focus:ring-2 focus:ring-gold-400 outline-none"
              />
            </div>
          </div>
        </div>

        <div class="pt-4">
          <button
            type="button"
            class="px-5 py-2.5 bg-navy-950 hover:bg-navy-900 text-gold-300 font-bold text-xs rounded-lg transition-colors shadow-sm"
            onclick="alert('Pengaturan Tersimpan: Pengaturan ini tersinkronisasi otomatis dengan file konstanta dan tabel website_settings Supabase.')"
          >
            Simpan Perubahan Pengaturan
          </button>
        </div>
      </form>
    </div>

  </div>
</AdminLayout>
