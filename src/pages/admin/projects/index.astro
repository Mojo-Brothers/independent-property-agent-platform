---
import AdminLayout from '../../../layouts/AdminLayout.astro';

const token = Astro.cookies.get('ipa_admin_token')?.value;
if (!token) {
  return Astro.redirect('/admin/login');
}

const projects = [
  {
    id: 'proj-01',
    name: 'Kawasan Residensial Asteria Cikarang',
    developer: 'PT Sinergi Graha Cikarang',
    marketing_type: 'Co-Brokering',
    city: 'Kabupaten Bekasi',
    district: 'Cikarang Selatan',
    status: 'Published',
  },
  {
    id: 'proj-02',
    name: 'Cluster Emerald Villa Mandiri',
    developer: 'PT Kencana Prima Lestari',
    marketing_type: 'Exclusive',
    city: 'Kabupaten Bekasi',
    district: 'Tambun Selatan',
    status: 'Published',
  },
  {
    id: 'proj-03',
    name: 'Urban Living Heritage Satria',
    developer: 'PT Harapan Bangun Persada',
    marketing_type: 'Open Listing',
    city: 'Kota Bekasi',
    district: 'Medan Satria',
    status: 'Published',
  },
];
---

<AdminLayout title="Kelola Proyek Kawasan (Projects)" activeNav="projects">
  <div class="space-y-6 max-w-7xl mx-auto">
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
      <div>
        <h2 class="text-base font-bold text-navy-950">Daftar Kawasan Proyek Pengembang</h2>
        <p class="text-xs text-slate-500">Katalog master proyek kawasan perumahan dan komersial.</p>
      </div>
      <div>
        <button
          type="button"
          class="px-4 py-2 bg-navy-950 hover:bg-navy-900 text-gold-300 font-bold text-xs rounded-lg transition-colors"
          onclick="alert('Tambah Proyek: Masukkan data master proyek ke tabel property_projects Supabase.')"
        >
          + Tambah Proyek Kawasan
        </button>
      </div>
    </div>

    <!-- Projects Table -->
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-50 text-slate-700 uppercase font-bold text-[10px] tracking-wider border-b border-slate-200">
            <tr>
              <th class="py-3.5 px-4">Nama Proyek</th>
              <th class="py-3.5 px-4">Pengembang Terkait</th>
              <th class="py-3.5 px-4">Model Pemasaran</th>
              <th class="py-3.5 px-4">Wilayah Lokasi</th>
              <th class="py-3.5 px-4">Status Publikasi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {projects.map((proj) => (
              <tr class="hover:bg-slate-50/80 transition-colors">
                <td class="py-3.5 px-4 font-bold text-navy-950">{proj.name}</td>
                <td class="py-3.5 px-4 text-slate-600">{proj.developer}</td>
                <td class="py-3.5 px-4">
                  <span class="inline-block px-2 py-0.5 rounded text-[10px] font-semibold bg-navy-100 text-navy-950">
                    {proj.marketing_type}
                  </span>
                </td>
                <td class="py-3.5 px-4 text-slate-600">{proj.district}, {proj.city}</td>
                <td class="py-3.5 px-4">
                  <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-800">
                    {proj.status}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</AdminLayout>
