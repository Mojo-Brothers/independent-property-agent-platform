---
import AdminLayout from '../../../layouts/AdminLayout.astro';

const token = Astro.cookies.get('ipa_admin_token')?.value;
if (!token) {
  return Astro.redirect('/admin/login');
}

const mockPartnerships = [
  {
    id: 'part-01',
    company_name: 'PT Pos Properti Indonesia',
    project_name: 'Eksplorasi Proyek Aset Strategis Koridor Bekasi',
    pic_name: 'Bpk. Ahmad Fauzi (General Manager Pemasaran)',
    phone: '0811998877',
    email: 'ahmad.fauzi@posproperti.co.id',
    proposal_message: 'Mengajukan diskusi eksplorasi skema kerja sama pemasaran properti dan optimalisasi aset lahan untuk pengembangan hunian cluster di wilayah Jawa Barat.',
    status: 'Under Review',
    created_at: '2026-11-18 11:00',
    notes: 'Draft materi presentasi profil kapabilitas Robby Viory Fansya telah disiapkan.',
  },
  {
    id: 'part-02',
    company_name: 'PT Cikarang Sukses Makmur',
    project_name: 'Cluster Green Lake Cikarang Timur',
    pic_name: 'Bpk. Budi Santoso (Direktur Operasional)',
    phone: '081233445566',
    email: 'budi@cikarangsukses.com',
    proposal_message: 'Kami memiliki 45 unit rumah cluster 1 lantai siap bangun, membutuhkan mitra agen independen untuk mengelola kampanye iklan digital dan registrasi konsumen.',
    status: 'Proposal Sent',
    created_at: '2026-11-16 15:20',
    notes: 'Proposal komisi dan SLA pelaporan leads telah dikirimkan via email.',
  },
];
---

<AdminLayout title="Pengajuan Kemitraan Developer" activeNav="partnerships">
  <div class="space-y-6 max-w-7xl mx-auto">
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
      <div>
        <h2 class="text-base font-bold text-navy-950">Pipeline Kemitraan Pengembang Properti</h2>
        <p class="text-xs text-slate-500">Kelola pengajuan kemitraan formal dari pengembang dan lembaga pengembang properti.</p>
      </div>
      <div>
        <span class="px-3 py-1 bg-navy-950 text-gold-300 font-bold rounded-lg text-xs">
          {mockPartnerships.length} Permintaan Masuk
        </span>
      </div>
    </div>

    <!-- Partnerships Table -->
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-50 text-slate-700 uppercase font-bold text-[10px] tracking-wider border-b border-slate-200">
            <tr>
              <th class="py-3.5 px-4">Nama Perusahaan & Proyek</th>
              <th class="py-3.5 px-4">Kontak PIC</th>
              <th class="py-3.5 px-4">Isi Ringkasan Proposal</th>
              <th class="py-3.5 px-4">Status Pengajuan</th>
              <th class="py-3.5 px-4">Tindak Lanjut & Notes</th>
              <th class="py-3.5 px-4 text-right">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {mockPartnerships.map((req) => (
              <tr class="hover:bg-slate-50/80 transition-colors">
                <td class="py-3.5 px-4">
                  <p class="font-bold text-navy-950">{req.company_name}</p>
                  <p class="text-slate-600 font-medium">{req.project_name}</p>
                  <p class="text-[10px] text-slate-400 font-mono">{req.created_at}</p>
                </td>
                <td class="py-3.5 px-4">
                  <p class="font-semibold text-slate-800">{req.pic_name}</p>
                  <p class="text-[10px] text-slate-500">{req.phone}</p>
                  <p class="text-[10px] text-slate-500">{req.email}</p>
                </td>
                <td class="py-3.5 px-4 max-w-xs text-slate-700 text-[11px] leading-relaxed">
                  {req.proposal_message}
                </td>
                <td class="py-3.5 px-4">
                  <span class={`inline-block px-2.5 py-1 rounded text-[10px] font-bold ${
                    req.status === 'Under Review' ? 'bg-amber-100 text-amber-800' :
                    req.status === 'Proposal Sent' ? 'bg-blue-100 text-blue-800' :
                    req.status === 'Approved' ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-100 text-slate-700'
                  }`}>
                    {req.status}
                  </span>
                </td>
                <td class="py-3.5 px-4 text-slate-600 max-w-xs text-[11px]">
                  {req.notes}
                </td>
                <td class="py-3.5 px-4 text-right">
                  <a
                    href={`https://wa.me/${req.phone}?text=Halo%20${encodeURIComponent(req.pic_name)},%20saya%20Robby%20Viory%20Fansya%20ingin%20menindaklanjuti%20pengajuan%20kemitraan%20${encodeURIComponent(req.company_name)}.`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center px-2.5 py-1 rounded bg-navy-950 text-gold-300 font-bold text-[10px] hover:bg-navy-900 transition-colors"
                  >
                    Respon PIC
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</AdminLayout>
