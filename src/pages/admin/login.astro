---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { BRAND } from '../../lib/constants';

// If already logged in, redirect to admin overview
const token = Astro.cookies.get('ipa_admin_token')?.value;
if (token) {
  return Astro.redirect('/admin');
}
---

<BaseLayout
  title={`Admin Login Portal – ${BRAND.name}`}
  description="Akses terproteksi administrasi Independent Property Agent platform."
>
  <div class="min-h-[80vh] flex items-center justify-center py-16 px-4 bg-navy-950 relative overflow-hidden">
    <!-- Ambient glow -->
    <div class="absolute -top-40 -right-40 w-80 h-80 bg-gold-400/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-40 -left-40 w-80 h-80 bg-navy-800/40 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-md w-full bg-navy-900 border border-gold-400/30 rounded-2xl p-8 sm:p-10 shadow-2xl relative z-10 space-y-6">
      
      <!-- Brand & Title Header -->
      <div class="text-center space-y-2">
        <div class="w-12 h-12 rounded-xl bg-navy-950 border border-gold-400/40 text-gold-400 mx-auto flex items-center justify-center shadow-sm">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
        </div>
        <h1 class="text-xl font-bold font-serif text-white tracking-wide">
          Portal Administrasi Tim Advisory
        </h1>
        <p class="text-xs text-gold-400 uppercase tracking-widest font-medium">
          {BRAND.name}
        </p>
        <p class="text-[11px] text-slate-400">
          Sistem tertutup khusus pengelolaan listing, prospek lead, dan kemitraan developer.
        </p>
      </div>

      <!-- Login Form -->
      <form id="admin-login-form" class="space-y-4">
        <div>
          <label for="login-email" class="block text-xs font-semibold text-slate-300 mb-1">
            Email Administrator
          </label>
          <input
            type="email"
            id="login-email"
            name="email"
            required
            value="admin@ivorygraceproperty.com"
            placeholder="admin@ivorygraceproperty.com"
            class="w-full px-3.5 py-2.5 bg-navy-950 border border-navy-700 rounded-lg text-xs text-white placeholder-slate-500 focus:outline-none focus:border-gold-400"
          />
        </div>

        <div>
          <label for="login-password" class="block text-xs font-semibold text-slate-300 mb-1">
            Kata Sandi
          </label>
          <input
            type="password"
            id="login-password"
            name="password"
            required
            placeholder="••••••••••••"
            class="w-full px-3.5 py-2.5 bg-navy-950 border border-navy-700 rounded-lg text-xs text-white placeholder-slate-500 focus:outline-none focus:border-gold-400"
          />
        </div>

        <div id="login-feedback" class="hidden text-xs p-3 rounded-lg"></div>

        <div class="pt-2">
          <button
            type="submit"
            id="btn-login"
            class="w-full py-3 px-4 rounded-lg bg-gold-400 hover:bg-gold-300 text-navy-950 font-bold text-xs uppercase tracking-wider transition-colors shadow-sm"
          >
            Masuk ke Dashboard
          </button>
        </div>
      </form>

      <!-- Security Notice -->
      <div class="pt-4 border-t border-navy-800 text-[11px] text-slate-400 text-center space-y-1">
        <p class="font-medium text-slate-300">Pemberitahuan Keamanan:</p>
        <p>Pendaftaran akun baru dinonaktifkan secara publik demi kepatuhan integritas data.</p>
        <p class="text-[10px] text-slate-500 pt-1">
          Kredensial Setup Awal: <code class="text-gold-400 bg-navy-950 px-1 py-0.5 rounded">admin@ivorygraceproperty.com</code> / <code class="text-gold-400 bg-navy-950 px-1 py-0.5 rounded">AdminProperti2026!</code>
        </p>
      </div>

    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('admin-login-form') as HTMLFormElement;
  const feedback = document.getElementById('login-feedback');
  const btn = document.getElementById('btn-login');

  if (form && feedback && btn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      btn.setAttribute('disabled', 'true');
      btn.classList.add('opacity-70');
      feedback.classList.remove('hidden', 'bg-rose-900/60', 'text-rose-200', 'bg-emerald-900/60', 'text-emerald-200');
      feedback.classList.add('bg-navy-950', 'text-slate-300');
      feedback.textContent = 'Memverifikasi akun...';

      const formData = new FormData(form);
      const email = formData.get('email');
      const password = formData.get('password');

      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password }),
        });

        const data = await res.json();
        if (res.ok && data.success) {
          feedback.classList.remove('bg-navy-950', 'text-slate-300');
          feedback.classList.add('bg-emerald-900/60', 'text-emerald-200', 'border', 'border-emerald-700');
          feedback.textContent = data.message + ' Mengalihkan...';
          setTimeout(() => {
            window.location.href = '/admin';
          }, 800);
        } else {
          feedback.classList.remove('bg-navy-950', 'text-slate-300');
          feedback.classList.add('bg-rose-900/60', 'text-rose-200', 'border', 'border-rose-700');
          feedback.textContent = data.message || 'Gagal login. Periksa email dan sandi Anda.';
          btn.removeAttribute('disabled');
          btn.classList.remove('opacity-70');
        }
      } catch (err) {
        feedback.classList.remove('bg-navy-950', 'text-slate-300');
        feedback.classList.add('bg-rose-900/60', 'text-rose-200', 'border', 'border-rose-700');
        feedback.textContent = 'Terjadi gangguan jaringan server.';
        btn.removeAttribute('disabled');
        btn.classList.remove('opacity-70');
      }
    });
  }
</script>
